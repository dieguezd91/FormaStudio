# Copy to .env (git-ignored) at the repo root or in services/local, then restart the local service.
# Variables already set in the environment take precedence over .env.

# Enables the AI features (requirements, proposals, natural-language edits). Without it the
# service runs normally and AI routes answer 503 `aiUnavailable`.
# Get a key at https://aistudio.google.com/apikey
# NOTE: a Google AI Pro / Google One subscription does NOT include Gemini API usage. A key without
# billing runs on the API free tier (small daily quota per model); enable billing for the project
# in Google AI Studio for more.
GOOGLE_GENERATIVE_AI_API_KEY=

# Kill switch (default true). `false` or `0` turns every AI feature off even if a key is set:
# AI routes answer 503 `aiDisabled` and nothing is sent to Google. See GET /ai/status.
# FORMA_AI_ENABLED=true

# Optional model overrides (defaults to the current stable Gemini Flash: gemini-3.8-flash).
# FORMA_AI_MODEL=gemini-3.8-flash
# Model used when a request contains images; defaults to FORMA_AI_MODEL.
# FORMA_AI_VISION_MODEL=gemini-3.8-flash

# Optional local service settings.
# FORMA_PORT=4318
# FORMA_DATA_DIR=
